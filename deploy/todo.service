# The app itself. Installed to /etc/systemd/system/todo.service by
# deploy/setup.sh, which replaces @APP_DIR@ with the repository's real path.
#
# .env is the source of truth: systemd loads it before the process starts, so
# DATABASE_URL, SESSION_SECURE and friends are already in the environment when
# the binary's own dotenv loader runs.

[Unit]
Description=To-do app (Axum + libSQL)
After=network-online.target sqld.service
Wants=network-online.target
Wants=sqld.service

[Service]
Type=simple
User=practice
Group=practice
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
ExecStart=/usr/local/bin/todo
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
