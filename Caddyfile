# Template: deploy/setup.sh replaces {$DOMAIN} with the DOMAIN from .env and
# writes the result to /etc/caddy/Caddyfile.
#
# A real domain gets automatic HTTPS from Let's Encrypt. reverse_proxy sets
# X-Forwarded-For with the client address, which is what the app's auth rate
# limiting keys on; the app itself listens on loopback only.

{$DOMAIN} {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
