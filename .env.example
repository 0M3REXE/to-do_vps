# Local development only. `.env` is gitignored.
# Production settings are managed by Piku, not copied from this file.

# Local SQLite-compatible libSQL database file.
DATABASE_URL=file:todo.db

# Local development listens on loopback. Piku sets BIND_ADDRESS and PORT.
ADDR=127.0.0.1:3000

RUST_LOG=info
SESSION_SECURE=false
# Required in production (SESSION_SECURE=true). Generate with: openssl rand -hex 32
# SESSION_SECRET=
# Optional timing overrides. Defaults: 60 minutes idle, 10 minutes step-up,
# 30 days device cookie. Absolute session lifetime is 7 days.
# SESSION_IDLE_MINUTES=60
# SESSION_STEP_UP_MINUTES=10
# SESSION_DEVICE_DAYS=30
