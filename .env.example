# Copy to `.env` and adjust. `.env` is gitignored because it holds secrets.
# systemd loads it (EnvironmentFile in deploy/todo.service) and `cargo run`
# loads it through dotenvy — keep it to plain KEY=VALUE lines and comments.

# --- site ---
# The domain Caddy serves, and the host it obtains a Let's Encrypt
# certificate for. Point the domain's A record at the VPS first.
# Use `localhost` only for a plain-http smoke test on the box itself
# (and set SESSION_SECURE=false then — a Secure cookie is never sent over
# plain http, so a wrong value there silently logs everybody out).
DOMAIN=todo.example.com

# --- database ---
# The VPS runs its own Turso (libSQL/sqld) service on loopback. Never expose
# port 8080: sqld has authentication off and would be an open database.
DATABASE_URL=http://127.0.0.1:8080

# Only for a database that demands a token (Turso cloud). Leave unset for the
# local sqld.
#DATABASE_AUTH_TOKEN=

# --- app ---
# Loopback only: Caddy proxies to it, and nothing else should reach it.
ADDR=127.0.0.1:3000

# --- logging ---
# debug logs every request; info is enough for normal use.
RUST_LOG=info

# --- sessions ---
# Adds `Secure` to the session cookie. true behind Caddy (browsers talk
# https); set false only for a plain-http localhost test.
SESSION_SECURE=true

# Optional but recommended: signs the session cookie. Exactly 64 bytes —
# generate with `openssl rand -hex 32`. Rotating it signs everyone out.
#SESSION_SECRET=
